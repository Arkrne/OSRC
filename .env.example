NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only secret (NEVER prefix with NEXT_PUBLIC). Used by /api/upload to
# write to Storage as a trusted admin identity, bypassing RLS. The route is
# auth-gated so only logged-in admins can trigger it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key
INQUIRY_EMAIL=your-email@example.com
RESEND_FROM=OSRC Inquiries <noreply@orangesquarerealty.com.ph>
# Upstash Redis — cross-instance rate limiting for /api/send-inquiry.
# Get both values from console.upstash.com → your database → REST API.
# Without these, rate limiting falls back to in-memory (fine for local dev, not production).
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Comma-separated Supabase UIDs allowed to access /admin AND the admin API
# routes (/api/upload, /api/delete-listing). Find your UID in the Supabase
# Dashboard → Authentication → Users.
# REQUIRED: the proxy and the admin API routes now FAIL CLOSED — if this is
# unset/empty, ALL admin access (login redirect, uploads, deletes) is denied.
ADMIN_ALLOWED_UIDS=your-supabase-uid-here
# Optional: error-reporting webhook (Slack/Discord-compatible). When set, API
# route failures (inquiry/upload/delete) POST a structured payload here in
# addition to the server log. Leave unset to log-only.
ERROR_WEBHOOK_URL=
